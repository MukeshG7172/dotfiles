{
  "layer": "top",
  "position": "top",
  "height": 16,
  "spacing": 1,
  "margin-top": 2,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/player",
    "clock",
    "custom/notifications"
  ],
  "modules-right": [
    "backlight",
    "pulseaudio",
    "bluetooth",
    "network",
    "battery",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "on-click": "activate"
  },

  "hyprland/window": {
    "format": "󰍹   {title}",
    "max-length": 30,
    "separate-outputs": true,
    "rewrite": {
      "": "Desktop"
    }
  },

  "clock": {
    "interval": 1,
    "format": "󰸉   {:%a %d %b  %H:%M}",
    "format-alt": "󰥔   {:%H:%M:%S}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "custom/notifications": {
    "exec": "~/.config/waybar/scripts/notifications.sh",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/notification-center.sh",
    "on-click-right": "swaync-client -d"
  },

  "custom/player": {
    "exec": "~/.config/waybar/scripts/player-mpris-simple.sh",
    "interval": 2,
    "format": "󰎈   {}",
    "return-type": "string",
    "max-length": 35
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}   {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "min-length": 8,
    "on-click": "brightnessctl s +5%",
    "on-click-right": "brightnessctl s 5%-"
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}   {capacity}%",
    "format-charging": "󰂄   {capacity}%",
    "format-plugged": "󰚥   {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "min-length": 8,
    "tooltip-format": "{timeTo}, {capacity}%"
  },

  "network": {
    "interval": 2,
    "format-wifi": "󰤨  {bandwidthDownBytes}",
    "format-ethernet": "󰈀  {bandwidthDownBytes}",
    "format-disconnected": "󰤭  Off",
    "min-length": 8,
    "max-length": 10,
    "tooltip-format-wifi": "{essid} ({signalStrength}%) | 󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr} | 󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
    "on-click": "kitty -e nmtui",
    "on-click-right": "nmcli radio wifi toggle"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} - {device_battery_percentage}%",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon}   {volume}%",
    "format-muted": "󰖁   Mute",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "min-length": 8,
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "wlogout"
  }
}

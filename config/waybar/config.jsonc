{
  "layer": "top",
  "position": "top",
  "height": 22,
  "spacing": 0,
  "margin-top": 0,
  "margin-bottom": 0,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/player",
    "custom/notifications",
    "backlight",
    "pulseaudio",
    "bluetooth",
    "network",
    "battery",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "format": "{name}"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 40,
    "separate-outputs": true
  },

  "clock": {
    "interval": 1,
    "format": "{:%a %d %b  %H:%M:%S}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "custom/notifications": {
    "exec": "~/.config/waybar/scripts/notifications.sh",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/notification-center.sh",
    "on-click-right": "swaync-client -d"
  },

  "custom/player": {
    "exec": "~/.config/waybar/scripts/player-mpris-simple.sh",
    "interval": 2,
    "format": "{}",
    "return-type": "string",
    "max-length": 40
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "  {percent}%",
    "min-length": 7,
    "on-click": "brightnessctl s +5%",
    "on-click-right": "brightnessctl s 5%-"
  },

  "battery": {
    "interval": 30,
    "format": "{icon}  {capacity}%",
    "min-length": 7,
    "format-icons": {
      "charging":    " ** ",
      "discharging": "  ",
      "full":        " -- "
    },
    "tooltip-format": "{timeTo}, {capacity}%"
  },

  "network": {
    "interval": 2,
    "format-wifi":         "    {bandwidthDownBytes}",
    "format-ethernet":     "    {bandwidthDownBytes}",
    "format-disconnected": "    off",
    "min-length": 12,
    "max-length": 12,
    "tooltip-format-wifi":     "{essid}  {signalStrength}% | down:{bandwidthDownBytes} up:{bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr} | down:{bandwidthDownBytes} up:{bandwidthUpBytes}",
    "on-click": "kitty -e nmtui"
  },

  "bluetooth": {
    "format":                                     "",
    "format-disabled":                            "",
    "format-connected":                           "  {num_connections}",
    "tooltip-format":                             "{status}",
    "tooltip-format-connected":                   "{device_enumerate}",
    "tooltip-format-enumerate-connected":         "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} - {device_battery_percentage}%",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format":       "{icon}  {volume}%",
    "format-muted": "x",
    "format-icons": [" ", "  ", "  "],
    "min-length": 7,
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
